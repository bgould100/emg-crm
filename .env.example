# Database
DATABASE_URL=postgresql://emg:CHANGE_ME@localhost:5432/emg
DATABASE_URL_DOCKER=postgresql://emg:CHANGE_ME@YOUR_DATABASE_HOST:5432/emg

# Browser security
EMG_ALLOWED_ORIGIN=http://localhost:8000
EMG_COOKIE_SECURE=false

# Security secrets — generate separate random values for each environment
EMG_RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET
EMG_REVIEW_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET

# Contractor invoice email
EMG_SES_REGION=us-east-2
EMG_SES_FROM_EMAIL=billing@elitematchgroup.com
EMG_SES_FROM_NAME=EliteMatch Group
EMG_SES_REPLY_TO_EMAIL=vip@elitematchgroup.com

# Homeowner review email
EMG_REVIEW_EMAIL_FROM=billing@elitematchgroup.com
EMG_REVIEW_BASE_URL=https://YOUR_STAGING_HOSTNAME